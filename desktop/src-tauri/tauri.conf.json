{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tool News",
  "version": "1.0.0",
  "identifier": "vn.toolnews.app",
  "build": {
    "frontendDist": "../placeholder"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": [
      "payload/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    },
    "shortDescription": "Dung ban tin doc tu text va anh/video",
    "longDescription": "Tool News — go noi dung, chon anh hoac video trong may, nhan ve file MP4 doc 1080x1920 kieu ban tin."
  }
}
